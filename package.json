{
  "name": "hhfast-workspace",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter @nnnb/hhfast-playground dev",
    "dev:backend": "pnpm --filter @nnnb/hhfast-playground-backend dev",
    "build:playground": "pnpm --filter @nnnb/hhfast-playground build",
    "build": "pnpm -r --filter ./packages/** build",
    "build:ui": "pnpm --filter @nnnb/hhfast-ui build",
    "build:utils": "pnpm --filter @nnnb/hhfast-utils build",
    "test": "pnpm -r --filter ./packages/** --if-present test",
    "test:ui": "pnpm --filter @nnnb/hhfast-ui test",
    "test:playground": "pnpm --filter @nnnb/hhfast-playground test:e2e",
    "test:utils": "pnpm --filter @nnnb/hhfast-utils test",
    "typecheck": "pnpm -r --filter ./packages/** typecheck",
    "typecheck:ui": "pnpm --filter @nnnb/hhfast-ui typecheck",
    "typecheck:utils": "pnpm --filter @nnnb/hhfast-utils typecheck",
    "release:ui": "pnpm --filter @nnnb/hhfast-ui typecheck && pnpm --filter @nnnb/hhfast-ui build",
    "release:utils": "pnpm --filter @nnnb/hhfast-utils typecheck && pnpm --filter @nnnb/hhfast-utils build",
    "verify:packages": "node scripts/verify-packed-packages.mjs",
    "release:check": "pnpm test && pnpm typecheck && pnpm build && pnpm build:playground && pnpm test:playground && pnpm verify:packages",
    "publish:ui": "pnpm --filter @nnnb/hhfast-ui publish --access public",
    "publish:utils": "pnpm --filter @nnnb/hhfast-utils publish --access public",
    "docs:api": "pnpm --filter @nnnb/hhfast-ui docs:api",
    "docs:api:watch": "pnpm --filter @nnnb/hhfast-ui docs:api:watch"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "element-plus": "^2.13.6",
    "react": "^19.2.5",
    "sass": "^1.98.0",
    "tailwindcss": "^4.2.2",
    "typedoc": "^0.28.18",
    "typescript": "^5.7.3",
    "vite": "^6.2.1",
    "vite-plugin-dts": "^4.5.0",
    "vue": "^3.5.13"
  }
}
