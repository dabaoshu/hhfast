{
  "name": "@nnnb/hhfast-utils",
  "version": "0.0.1",
  "description": "Core utilities for hhfast, framework agnostic.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./background-task-manager": {
      "types": "./dist/core/background-task-manager/index.d.ts",
      "import": "./dist/core/background-task-manager/index.js"
    },
    "./task-execution-chain": {
      "types": "./dist/core/task-execution-chain/index.d.ts",
      "import": "./dist/core/task-execution-chain/index.js"
    },
    "./resumable-transfer": {
      "types": "./dist/core/resumable-transfer/index.d.ts",
      "import": "./dist/core/resumable-transfer/index.js"
    },
    "./json-to-tree": {
      "types": "./dist/core/json-to-tree/index.d.ts",
      "import": "./dist/core/json-to-tree/index.js"
    },
    "./curl-to-request": {
      "types": "./dist/core/curl-to-request/index.d.ts",
      "import": "./dist/core/curl-to-request/index.js"
    }
  },
  "files": [
    "dist/",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/nnnb/hhfast#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nnnb/hhfast.git"
  },
  "bugs": {
    "url": "https://github.com/nnnb/hhfast/issues"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "spark-md5": "^3.0.2"
  },
  "devDependencies": {
    "@types/spark-md5": "^3.0.5",
    "vitest": "3.2.4"
  }
}
